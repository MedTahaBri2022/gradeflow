# All variables are optional in development (defaults match docker-compose.yml).
NODE_ENV=development
PORT=3002
DATABASE_URL=postgres://gradeflow:gradeflow@localhost:54323/gradeflow
REDIS_URL=redis://localhost:63793
CORS_ORIGIN=http://localhost:5175
# false = HTTP API only; run workers separately with `npm run start:worker`.
RUN_WORKER=true
# Pause after each batch of 500 rows, to watch progress on small files (demo only).
IMPORT_BATCH_DELAY_MS=0
